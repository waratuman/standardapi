# The associations +permit+ lists on +model+, each true or its own include,
# and with +options+ the options that apply to included records. The include
# of an association is named after +prefix+.
json.set! 'type', 'object'
json.set! 'properties' do
  json.object! do
    permit.each do |name, subpermit|
      next if StandardAPI::Controller::RESERVED_INCLUDE_KEYS.include?(name.to_s)

      # The include partial's locals
      sub = json_schema_include_locals(model, name, subpermit, prefix)

      included = { 'enum' => [true, 'true'] }
      if !sub
        json.set! name.to_s, included
        next
      end

      json.set! name.to_s do
        json.object! do
          json.set! 'anyOf' do
            json.array! do
              json.value! included
              json.object! do
                if model
                  # The +when+ of an include is checked against the model it's
                  # on, and the include's schema is shared by every model
                  # including it
                  json.set! 'allOf' do
                    json.array! do
                      json.object! do
                        json.partial!('application/json_schema/include', sub.merge(defs: defs))
                      end
                      json.value!({ 'properties' => { 'when' => json_schema_ref(defs, json_schema_name(model, 'When'), 'when', model: model) } })
                    end
                  end
                else
                  json.partial!('application/json_schema/include', sub.merge(defs: defs))
                end
              end
            end
          end
        end
      end
    end

    json.merge! json_schema_include_options(defs, model) if options
  end
end
json.set! 'additionalProperties', false

json.object! do
  required = Set.new
  json.set! 'title', model.table_name.titleize.singularize
  json.set! 'type', 'object'
  if comment = model.connection.table_comment(model.table_name)
    json.set! 'description', comment
  end
  json.set! 'properties' do
    json.object! do
      schemas_for(model).each do |attribute|
        name = attribute[:name]
        next if includes["only"]&.exclude?(name)
        next if includes["except"]&.include?(name)
        column_schema = json_attribute_schema(attribute[:type])

        column_schema[:readOnly] = true if attribute[:read_only] || attribute[:auto_populated]
        column_schema[:default] = attribute[:default] if !attribute[:default].nil?
        column_schema[:description] = attribute[:description] if attribute[:description]
        required.add(name) if attribute[:required]

        attribute[:validations].each do |v|
          options = v[:options]
          case v[:kind]
          when :numericality
            column_schema["exclusiveMinimum"] = options[:greater_than] if options[:greater_than]
            column_schema["exclusiveMaximum"] = options[:less_than] if options[:less_than]
            column_schema["minimum"] = options[:greater_than_or_equal_to] if options[:greater_than_or_equal_to]
            column_schema["maximum"] = options[:less_than_or_equal_to] if options[:less_than_or_equal_to]
          when :inclusion
            column_schema["enum"] = options[:in] if options[:in]
          when :acceptance
            column_schema["const"] = true
          when :format
            column_schema["pattern"] = options[:with] if options[:with]
          when :length
            column_schema["minLength"] = options[:minimum] if options[:minimum]
            column_schema["maxLength"] = options[:maximum] if options[:maximum]
          when :presence
            # Already counted in attribute[:required]
          else
            puts "******* MISSING VALIDATOR **********"
            puts v.inspect
            warn "missing validator"
          end
        end

        json.set! name do
          json.object! do
            if attribute[:array]
              json.set! 'type', 'array'
              json.set! 'items', column_schema
            else
              json.merge! column_schema
            end
          end
        end
      end
      includes.each do |inc, subinc|
        next if %w(only except).include?(inc)
        next if includes["only"]&.exclude?(inc)
        next if includes["except"]&.include?(inc)
        case association = model.reflect_on_association(inc)
        when ::ActiveRecord::Reflection::AbstractReflection
          json.set! inc do
            if association.collection?
              json.object! do
                json.set! 'type', 'array'
                json.set! 'items' do
                  json.partial!('json_schema', model: association.klass, includes: subinc)
                end
              end
            else
              json.partial!('json_schema', model: association.klass, includes: subinc)
            end
          end
        end
      end
    end
  end
  json.set! 'required', required.to_a
end
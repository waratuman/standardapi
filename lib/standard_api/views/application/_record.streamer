json.object! do

  policy = record_policy(record, local_assigns[:policy])
  policy.attributes.each do |definition|
    serialize_attribute(json, record, definition[:name], definition[:type]&.to_sym)
  end

  policy.includes(includes).each do |name, sub_include, sub_policy|
    case association = record.class.reflect_on_association(name)
    when ::ActiveRecord::Reflection::AbstractReflection
      if association.collection?
        can_cache = can_cache_relation?(record, name, sub_include, sub_policy)
        json.cache_if!(can_cache, can_cache ? [name, association_cache_key(record, name, sub_include)] : nil) do
          json.set! name do
            partial = model_partial(association.klass)
            # TODO limit causes preloaded assocations to reload
            sub_records = record.send(name)

            # Apply the controller's mask for the included association's table, so
            # row-level scoping (e.g. hiding restricted rows) is enforced on
            # includes the same as on the top-level resource.
            if respond_to?(:mask)
              sub_records = sub_records.filter(mask[association.klass.table_name.to_sym])
            end

            sub_records = sub_records.limit(sub_include["limit"]) if sub_include["limit"]
            sub_records = sub_records.offset(sub_include["offset"]) if sub_include["offset"]
            sub_records = sub_records.resort(sub_include["order"]) if sub_include["order"]
            sub_records = sub_records.filter(sub_include["where"]) if sub_include["where"]
            sub_records = sub_records.distinct if sub_include["distinct"]
            sub_records = sub_records.distinct_on(sub_include["distinct_on"]) if sub_include["distinct_on"]

            json.array! sub_records, partial: partial, as: partial.split("/").last, locals: { includes: sub_include, policy: sub_policy }
          end
        end
      else
        can_cache = can_cache_relation?(record, name, sub_include, sub_policy)
        if can_cache && association.is_a?(::ActiveRecord::Reflection::BelongsToReflection)
          can_cache = !record.send(association.foreign_key).nil?
        end
        json.cache_if!(can_cache, can_cache ? [name, association_cache_key(record, name, sub_include)] : nil) do
          json.set! name do
            value = record.send(name)
            if value.nil?
              json.value! nil
            else
              partial = model_partial(value)
              json.partial! partial, partial.split("/").last.to_sym => value, includes: sub_include, policy: sub_policy
            end
          end
        end
      end
    else
      if record.respond_to?(name)
        value = record.send(name)
        if value.nil?
          json.set! name, nil
        elsif value.is_a?(ActiveModel::Model)
          json.set! name do
            partial = model_partial(value)
            json.partial! partial, partial.split("/").last.to_sym => value, includes: sub_include, policy: sub_policy
          end
        else
          json.set! name, value.as_json
        end
      end
    end

  end

  if !record.errors.blank?
    json.set! 'errors', policy.errors
  end

end
